{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verilog2digital.local/schemas/v1/mapped",
  "title": "Scalar native mapping before placement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "top",
    "instances",
    "descriptors",
    "nets",
    "inputs",
    "outputs",
    "origins"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "profile": {
      "const": "scalar-v1"
    },
    "top": {
      "$ref": "#/$defs/name"
    },
    "instances": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/instance"
      }
    },
    "descriptors": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/descriptor"
      }
    },
    "nets": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/net"
      }
    },
    "inputs": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/port"
      }
    },
    "outputs": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/port"
      },
      "minItems": 1
    },
    "origins": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/origin"
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
    },
    "component": {
      "enum": [
        "In",
        "Out",
        "Const",
        "Not",
        "And",
        "Or",
        "XOr",
        "XNOr",
        "Multiplexer"
      ]
    },
    "attributes": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "type": [
          "string",
          "integer",
          "boolean"
        ]
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "y": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        }
      }
    },
    "origin_position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "const": 0
        },
        "y": {
          "type": "integer",
          "const": 0
        }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "$ref": "#/$defs/point"
        },
        "max": {
          "$ref": "#/$defs/point"
        }
      }
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "attributes",
        "position",
        "rotation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "$ref": "#/$defs/component"
        },
        "attributes": {
          "$ref": "#/$defs/attributes"
        },
        "position": {
          "$ref": "#/$defs/origin_position"
        },
        "rotation": {
          "type": "integer",
          "const": 0
        }
      }
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "pin",
        "width",
        "position",
        "escape"
      ],
      "properties": {
        "direction": {
          "enum": [
            "input",
            "output"
          ]
        },
        "pin": {
          "$ref": "#/$defs/name"
        },
        "width": {
          "type": "integer",
          "const": 1
        },
        "position": {
          "$ref": "#/$defs/point"
        },
        "escape": {
          "$ref": "#/$defs/point"
        }
      }
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "type",
        "attributes",
        "position",
        "rotation",
        "pins",
        "bounds",
        "body_bounds",
        "unsupported_attributes"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "$ref": "#/$defs/component"
        },
        "attributes": {
          "$ref": "#/$defs/attributes"
        },
        "position": {
          "$ref": "#/$defs/origin_position"
        },
        "rotation": {
          "type": "integer",
          "const": 0
        },
        "pins": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/pin"
          }
        },
        "bounds": {
          "$ref": "#/$defs/bounds"
        },
        "body_bounds": {
          "$ref": "#/$defs/bounds"
        },
        "unsupported_attributes": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/name"
          }
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_id",
        "direction",
        "pin"
      ],
      "properties": {
        "instance_id": {
          "$ref": "#/$defs/id"
        },
        "direction": {
          "enum": [
            "input",
            "output"
          ]
        },
        "pin": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "net": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "bit",
        "width",
        "endpoints"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(b[2-9][0-9]*|b1[0-9]+|k[01])$"
        },
        "bit": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 2,
              "maximum": 2147483647
            },
            {
              "enum": [
                "0",
                "1"
              ]
            }
          ]
        },
        "width": {
          "type": "integer",
          "const": 1
        },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/endpoint"
          }
        }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port",
        "instance_id",
        "width"
      ],
      "properties": {
        "port": {
          "$ref": "#/$defs/name"
        },
        "instance_id": {
          "$ref": "#/$defs/id"
        },
        "width": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_id",
        "kind",
        "source"
      ],
      "properties": {
        "instance_id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "port",
            "cell",
            "constant"
          ]
        },
        "source": {
          "type": "string"
        },
        "port": {
          "$ref": "#/$defs/name"
        },
        "cell_id": {
          "$ref": "#/$defs/id"
        },
        "native_name": {
          "$ref": "#/$defs/name"
        },
        "hierarchy": {
          "type": "string"
        },
        "value": {
          "enum": [
            "0",
            "1"
          ]
        }
      }
    }
  }
}
