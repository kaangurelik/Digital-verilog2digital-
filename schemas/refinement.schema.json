{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verilog2digital.local/schemas/v1/refinement",
  "type": "object", "additionalProperties": false,
  "properties": {
    "mode": {"enum": ["off", "local", "replay"]},
    "model_id": {"enum": ["qwen3-4b-q4_k_m", "qwen3-4b-q5_k_m", "qwen3-14b-q4_k_m"]},
    "context_tokens": {"type": ["integer", "null"], "minimum": 1024, "maximum": 8192},
    "model_memory_mib": {"type": "integer", "minimum": 64, "maximum": 12288},
    "idle_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 8},
    "budget_seconds": {"type": "number", "minimum": 1, "maximum": 300},
    "request": {"type": "string", "maxLength": 500},
    "responses": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 65536}}
  }
}
