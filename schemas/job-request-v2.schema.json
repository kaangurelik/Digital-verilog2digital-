{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verilog2digital.local/schemas/v2/job-request",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "job_id", "kind", "project", "options", "limits", "output_root", "cache"],
  "properties": {
    "schema_version": {"const": 2},
    "cache": {"type": "boolean"},
    "job_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "kind": {"enum": ["convert", "inspect", "validate"]},
    "output_root": {"type": ["string", "null"]},
    "project": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["sources", "top", "include_dirs", "defines", "parameters"],
      "properties": {
        "sources": {"type": "array", "minItems": 1, "maxItems": 1024, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "top": {"type": ["string", "null"]},
        "include_dirs": {"type": "array", "maxItems": 128, "items": {"type": "string"}},
        "defines": {"type": "object", "maxProperties": 256, "additionalProperties": {"type": "string"}},
        "parameters": {"type": "object", "maxProperties": 256, "additionalProperties": {"type": ["string", "integer"]}}
      }
    },
    "options": {"type": "object", "additionalProperties": false, "properties": {
      "spacing": {"type": "integer"}, "profile": {"type": "string"}, "seed": {"type": "integer"},
      "random_count": {"type": "integer"}, "layout_strategy": {"type": "string"}, "tunnels": {"type": "boolean"},
      "layout_timeout": {"type": "number"}, "sequential_trace": {"type": ["object", "null"]}, "flatten": {"type": "boolean"},
      "target_path": {"type": "string"}, "artifacts_only": {"type": "boolean"},
      "refinement": {"type": "object"}
    }},
    "limits": {"type": "object", "additionalProperties": false,
      "required": ["deadline_seconds", "memory_bytes", "process_memory_bytes", "java_heap_bytes", "active_process_limit"],
      "properties": {
        "deadline_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 86400},
        "memory_bytes": {"type": "integer", "minimum": 67108864, "maximum": 1099511627776},
        "process_memory_bytes": {"type": ["integer", "null"], "minimum": 67108864},
        "java_heap_bytes": {"type": "integer", "minimum": 67108864, "maximum": 68719476736},
        "active_process_limit": {"type": "integer", "minimum": 1, "maximum": 128}
      }
    }
  }
}
