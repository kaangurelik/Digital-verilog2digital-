{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verilog2digital.local/schemas/v1/layout-request",
  "title": "Native fixed-port layout request parameters",
  "type": "object",
  "additionalProperties": false,
  "required": ["instances", "nets"],
  "properties": {
    "package": {"$ref": "#/$defs/package"},
    "instances": {"type": "array", "minItems": 1, "maxItems": 250, "items": {"$ref": "#/$defs/instance"}},
    "nets": {"type": "array", "minItems": 1, "maxItems": 16384, "items": {"$ref": "#/$defs/net"}},
    "spacing": {"type": "integer", "minimum": 40, "maximum": 400, "multipleOf": 20, "default": 40},
    "seed": {"type": "integer", "const": 1, "default": 1}
  },
  "$defs": {
    "package": {
      "type": "object", "additionalProperties": false, "required": ["root", "modules"],
      "properties": {
        "root": {"type": "string", "minLength": 1, "maxLength": 16384},
        "modules": {
          "type": "array", "maxItems": 64,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["type", "sha256", "sidecar_sha256"],
            "properties": {
              "type": {"type": "string", "pattern": "^m_[0-9a-f]{24}\\.dig$"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "sidecar_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"},
    "origin": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": {"x": {"type": "integer", "const": 0}, "y": {"type": "integer", "const": 0}}
    },
    "instance": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "attributes", "position"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"type": "string", "minLength": 1, "maxLength": 128},
        "attributes": {
          "type": "object", "maxProperties": 64,
          "additionalProperties": {
            "oneOf": [{"type": "string", "maxLength": 4096}, {"type": "number"}, {"type": "boolean"}]
          }
        },
        "position": {"$ref": "#/$defs/origin"},
        "rotation": {"type": "integer", "enum": [0, 90, 180, 270], "default": 0}
      }
    },
    "endpoint": {
      "type": "object", "additionalProperties": false, "required": ["instance_id", "direction", "pin"],
      "properties": {
        "instance_id": {"$ref": "#/$defs/id"},
        "direction": {"enum": ["input", "output"]},
        "pin": {"type": "string", "minLength": 1, "maxLength": 16384}
      }
    },
    "net": {
      "type": "object", "additionalProperties": false, "required": ["id", "endpoints"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "endpoints": {"type": "array", "minItems": 1, "maxItems": 16384, "items": {"$ref": "#/$defs/endpoint"}}
      }
    }
  }
}
