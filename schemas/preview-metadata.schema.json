{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://verilog2digital.local/schemas/v1/preview-metadata",
  "type":"object","additionalProperties":false,
  "required":["schema_version","top","views"],
  "properties":{
    "schema_version":{"const":1},"top":{"type":"string","minLength":1,"maxLength":16384},
    "views":{"type":"object","additionalProperties":false,"required":["selected"],
      "properties":{"selected":{"$ref":"#/$defs/view"},"baseline":{"$ref":"#/$defs/view"}}}
  },
  "$defs":{
    "hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "point":{"type":"object","additionalProperties":false,"required":["x","y"],
      "properties":{"x":{"type":"integer","minimum":-2000000,"maximum":2000000},"y":{"type":"integer","minimum":-2000000,"maximum":2000000}}},
    "bounds":{"type":"object","additionalProperties":false,"required":["min","max"],
      "properties":{"min":{"$ref":"#/$defs/point"},"max":{"$ref":"#/$defs/point"}}},
    "pin":{"type":"object","additionalProperties":false,"required":["direction","pin","position","width"],
      "properties":{"direction":{"enum":["input","output","both"]},"pin":{"type":"string","maxLength":16384},
        "position":{"$ref":"#/$defs/point"},"width":{"type":["integer","null"],"minimum":1,"maximum":64}}},
    "instance":{"type":"object","additionalProperties":false,"required":["id","type","label","position","rotation","bounds","body_bounds","pins"],
      "properties":{"id":{"type":"string","minLength":1,"maxLength":128},"type":{"type":"string","minLength":1,"maxLength":16384},
        "label":{"type":"string","maxLength":16384},"position":{"$ref":"#/$defs/point"},"rotation":{"enum":[0,90,180,270]},
        "bounds":{"$ref":"#/$defs/bounds"},"body_bounds":{"$ref":"#/$defs/bounds"},
        "pins":{"type":"array","maxItems":1024,"items":{"$ref":"#/$defs/pin"}}}},
    "view":{"type":"object","additionalProperties":false,"required":["module_id","comparison_scope","image","circuit","circuit_to_pixel","instances"],
      "properties":{"module_id":{"type":["string","null"],"maxLength":128},
        "comparison_scope":{"enum":["selected_top_canvas","before_refinement","top_after_child_refinement_before_top_refinement"]},
        "image":{"type":"object","additionalProperties":false,"required":["artifact","sha256","width_px","height_px"],
          "properties":{"artifact":{"enum":["preview","baseline_preview"]},"sha256":{"$ref":"#/$defs/hash"},
            "width_px":{"type":"integer","minimum":1,"maximum":16384},"height_px":{"type":"integer","minimum":1,"maximum":16384}}},
        "circuit":{"type":"object","additionalProperties":false,"required":["sha256","sidecar_sha256"],
          "properties":{"sha256":{"$ref":"#/$defs/hash"},"sidecar_sha256":{"$ref":"#/$defs/hash"}}},
        "circuit_to_pixel":{"type":"object","additionalProperties":false,"required":["a","b","c","d","tx","ty"],
          "properties":{"a":{"type":"number"},"b":{"type":"number"},"c":{"type":"number"},"d":{"type":"number"},"tx":{"type":"number"},"ty":{"type":"number"}}},
        "instances":{"type":"array","maxItems":1024,"items":{"$ref":"#/$defs/instance"}}}
    }
  }
}
