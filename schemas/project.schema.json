{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verilog2digital.local/schemas/v1/project",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "sources": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "include_dirs": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "top": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$", "maxLength": 256},
    "defines": {"type": "object", "maxProperties": 256, "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"}, "additionalProperties": {"type": "string", "maxLength": 4096}},
    "parameters": {"type": "object", "maxProperties": 256, "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"}, "additionalProperties": {"oneOf": [{"type": "string", "maxLength": 4096}, {"type": "integer"}]}},
    "output": {"$ref": "#/$defs/path"},
    "trace": {"$ref": "#/$defs/path"},
    "conversion": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "spacing": {"type": "integer", "minimum": 40, "maximum": 400, "multipleOf": 20},
        "profile": {"enum": ["auto", "scalar-v1", "datapath-v1", "sequential-v1"]},
        "flatten": {"type": "boolean"}, "tunnels": {"type": "boolean"},
        "refinement": {"type": "object"},
        "layout_strategy": {"enum": ["auto", "reserved"]},
        "layout_timeout": {"type": "number", "minimum": 1, "maximum": 120},
        "seed": {"type": "integer"},
        "random_count": {"type": "integer", "minimum": 0, "maximum": 2048}
      }
    },
    "resources": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "deadline_seconds": {"type": "number", "minimum": 1, "maximum": 3600},
        "memory_mib": {"type": "integer", "minimum": 256, "maximum": 65536},
        "java_heap_mib": {"type": "integer", "minimum": 64, "maximum": 16384},
        "process_memory_mib": {"type": ["integer", "null"], "minimum": 128, "maximum": 65536}
      }
    }
  },
  "$defs": {"path": {"type": "string", "minLength": 1, "maxLength": 32760, "pattern": "^[^\\u0000\\r\\n]+$"}}
}
