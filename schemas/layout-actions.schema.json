{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verilog2digital.local/schemas/v1/layout-actions",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "actions", "explanation"],
  "properties": {
    "schema_version": {"const": 1},
    "candidate_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "explanation": {"type": "string", "maxLength": 1024},
    "actions": {"type": "array", "maxItems": 8, "items": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["action", "instance_id", "delta"],
       "properties": {"action": {"const": "move_component"}, "instance_id": {"$ref": "#/$defs/id"}, "delta": {"$ref": "#/$defs/delta"}}},
      {"type": "object", "additionalProperties": false, "required": ["action", "instance_ids", "delta"],
       "properties": {"action": {"const": "move_group"}, "instance_ids": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "delta": {"$ref": "#/$defs/delta"}}},
      {"type": "object", "additionalProperties": false, "required": ["action", "net_ids", "order"],
       "properties": {"action": {"const": "reroute_nets"}, "net_ids": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "order": {"enum": ["default", "reverse"]}}}
    ]}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"},
    "delta": {"type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": {"x": {"type": "integer", "minimum": -2000, "maximum": 2000, "multipleOf": 20},
                     "y": {"type": "integer", "minimum": -2000, "maximum": 2000, "multipleOf": 20}}}
  }
}
