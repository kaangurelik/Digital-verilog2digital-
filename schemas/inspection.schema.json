{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verilog2digital.local/schemas/v1/inspection",
  "title": "Verilog to Digital inspection version 1",
  "type": "object",
  "required": [
    "schema_version",
    "topology_available",
    "instances",
    "nets",
    "unconnected",
    "model",
    "wires"
  ],
  "properties": {
    "expanded": {"$ref": "#"},
    "schema_version": {
      "const": 1
    },
    "topology_available": {
      "type": "boolean"
    },
    "instances": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "attributes",
          "position",
          "rotation",
          "pins"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
          },
          "type": {
            "type": "string"
          },
          "attributes": {
            "type": "object"
          },
          "position": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "y": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              }
            }
          },
          "rotation": {
            "enum": [
              0,
              90,
              180,
              270
            ]
          },
          "pins": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "pin",
                "direction",
                "position",
                "width"
              ],
              "properties": {
                "pin": {
                  "type": "string",
                  "minLength": 1
                },
                "direction": {
                  "enum": [
                    "input",
                    "output",
                    "both"
                  ]
                },
                "position": {
                  "type": "object",
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "x": {
                      "type": "integer",
                      "minimum": -1000000,
                      "maximum": 1000000
                    },
                    "y": {
                      "type": "integer",
                      "minimum": -1000000,
                      "maximum": 1000000
                    }
                  }
                },
                "width": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1,
                  "maximum": 64
                }
              },
              "additionalProperties": true
            }
          },
          "bounds": {
            "type": "object",
            "required": [
              "min",
              "max"
            ],
            "additionalProperties": false,
            "properties": {
              "min": {
                "type": "object",
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": -1000000,
                    "maximum": 1000000
                  },
                  "y": {
                    "type": "integer",
                    "minimum": -1000000,
                    "maximum": 1000000
                  }
                }
              },
              "max": {
                "type": "object",
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": -1000000,
                    "maximum": 1000000
                  },
                  "y": {
                    "type": "integer",
                    "minimum": -1000000,
                    "maximum": 1000000
                  }
                }
              }
            }
          },
          "body_bounds": {
            "type": "object",
            "required": [
              "min",
              "max"
            ],
            "additionalProperties": false,
            "properties": {
              "min": {
                "type": "object",
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": -1000000,
                    "maximum": 1000000
                  },
                  "y": {
                    "type": "integer",
                    "minimum": -1000000,
                    "maximum": 1000000
                  }
                }
              },
              "max": {
                "type": "object",
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": -1000000,
                    "maximum": 1000000
                  },
                  "y": {
                    "type": "integer",
                    "minimum": -1000000,
                    "maximum": 1000000
                  }
                }
              }
            }
          },
          "splitter_bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "direction",
                "pin",
                "offset",
                "width"
              ],
              "properties": {
                "direction": {
                  "enum": [
                    "input",
                    "output",
                    "both"
                  ]
                },
                "pin": {
                  "type": "string"
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0
                },
                "width": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 64
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": true
      }
    },
    "nets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "endpoints"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "instance_id",
                "direction",
                "pin"
              ],
              "additionalProperties": false,
              "properties": {
                "instance_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
                },
                "direction": {
                  "enum": [
                    "input",
                    "output",
                    "both"
                  ]
                },
                "pin": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "unconnected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "instance_id",
          "direction",
          "pin"
        ],
        "additionalProperties": false,
        "properties": {
          "instance_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
          },
          "direction": {
            "enum": [
              "input",
              "output",
              "both"
            ]
          },
          "pin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "uniqueItems": true
    },
    "model": {
      "type": "object",
      "required": [
        "valid",
        "diagnostics"
      ],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "wires": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000,
                "multipleOf": 10
              },
              "y": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000,
                "multipleOf": 10
              }
            }
          },
          "to": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000,
                "multipleOf": 10
              },
              "y": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000,
                "multipleOf": 10
              }
            }
          },
          "net_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    }
  },
  "additionalProperties": true
}
