{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verilog2digital.local/schemas/v1/job-event",
  "type": "object", "additionalProperties": false,
  "required": ["jsonrpc", "method", "params"],
  "properties": {
    "jsonrpc": {"const": "2.0"},
    "method": {"enum": ["job.progress", "job.result", "job.error"]},
    "params": {"type": "object", "required": ["job_id"], "properties": {
      "job_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
      "stage": {"type": "string", "minLength": 1, "maxLength": 128},
      "result_path": {"type": "string"},
      "diagnostic": {"type": "object", "required": ["code", "message"]}
    }, "additionalProperties": false}
  },
  "allOf": [
    {"if": {"properties": {"method": {"const": "job.progress"}}}, "then": {"properties": {"params": {"required": ["stage"]}}}},
    {"if": {"properties": {"method": {"const": "job.result"}}}, "then": {"properties": {"params": {"required": ["result_path"]}}}},
    {"if": {"properties": {"method": {"const": "job.error"}}}, "then": {"properties": {"params": {"required": ["diagnostic"]}}}}
  ]
}
